# Copy this file to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.

# Resend (https://resend.com) – sends contact-form enquiries to your inbox
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered (comma-separate for several inboxes)
CONTACT_TO_EMAIL=hello@archiform.com
# Sender. Use an address on a domain you've verified in Resend.
# Until then, "ARCHIFORM <onboarding@resend.dev>" works but only delivers to your Resend sign-up email.
CONTACT_FROM_EMAIL=ARCHIFORM Website <onboarding@resend.dev>

# Your live domain, used for SEO links and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.archiform.com
